# pnpm uses an isolated node_modules layout by default, which means
# transitive dependencies of file: dependencies (e.g. tailwind-merge,
# class-variance-authority inside packages/design-system/) are placed
# inside .pnpm/ and are NOT visible to TypeScript when it follows the
# tsconfig "paths" mapping into ./packages/design-system/src/.
#
# Switch to the hoisted linker so the design-system's own dependencies
# appear in the root node_modules — this matches npm's behaviour and
# lets tsc resolve every import in the vendored design-system source.
node-linker=hoisted