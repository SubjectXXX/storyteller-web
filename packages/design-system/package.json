{
  "name": "@storyteller/design-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Storyteller shared design tokens. CSS custom properties plus exported constants for Tailwind theme, runtime color/spacing/typography lookups, and a CVA-style class helper.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./tokens.css": "./src/tokens.css",
    "./reset.css": "./src/reset.css",
    "./cva": {
      "types": "./src/cva.ts",
      "import": "./src/cva.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
